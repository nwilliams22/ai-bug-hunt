{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bug Finder",
  "version": "0.2.0",
  "identifier": "studio.baddong.bugfinder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bug Finder",
        "width": 1320,
        "height": 920,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Education",
    "shortDescription": "Find subtle bugs in AI-generated code.",
    "longDescription": "A course, a drill set and a timed review mode for the skill of reviewing AI-generated code: six review passes, drills with planted defects, and a per-language gotcha reference. Runs entirely offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
