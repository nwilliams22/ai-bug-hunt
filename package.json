{
  "name": "bug-finder",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A course and drill set for finding subtle bugs in AI-generated code.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run build && npm run smoke",
    "install-service": "bash scripts/install-service.sh",
    "uninstall-service": "bash scripts/uninstall-service.sh",
    "redeploy": "npm run build && bash scripts/restart-service.sh",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "prismjs": "^1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
